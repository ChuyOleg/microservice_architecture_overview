# resource-db
RESOURCE_DB_NAME=resource-db
RESOURCE_DB_USER=postgres
RESOURCE_DB_PASSWORD=postgres

# song-db
SONG_DB_NAME=song-db
SONG_DB_USER=postgres
SONG_DB_PASSWORD=postgres

# resource-service
RESOURCE_DB_URL=jdbc:postgresql://resource-db:5432/${RESOURCE_DB_NAME}

# song-service
SONG_DB_URL=jdbc:postgresql://song-db:5432/${SONG_DB_NAME}

# eureka-server
DISCOVERY_SERVICE_URL=http://discovery-service:8761/eureka/
